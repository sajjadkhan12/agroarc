# Keep build context small and reproducible.
# Used when building the backend image (context = project root).

# Version control
.git
.gitignore
.gitattributes

# Python
__pycache__
*.pyc
*.pyo
*.pyd
*.egg-info
.pytest_cache
.coverage
htmlcov
.venv
venv
env
ENV

# Editor / OS
.vscode
.idea
.cursor
.codex
.DS_Store
Thumbs.db
*.swp
*.swo

# Secrets & local config — NEVER bake into images
.env
.env.local
.env.*.local
.env.prod
backend/.env
backend/.env.local
secrets.json
credentials.json
*.pem
*.key

# Logs
*.log
backend/uvicorn.*.log

# Frontend (built separately)
frontend

# Not needed at runtime
notebooks
data
tests
scripts
*.md
agent-transcripts
terminals

# Backend extras (only backend/app is copied in Dockerfile)
backend/run.py
backend/.env.example
backend/models
backend/Dockerfile

# CI / metadata
.github
LICENSE
